# Security headers for the private app (read by Cloudflare Pages and by app/serve.mjs).
# Page-specific script rules (Content-Security-Policy) are added inside each page at build time;
# the policy below adds the parts that only work as a header.
/*
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), hid=(), midi=(), magnetometer=(), gyroscope=(), accelerometer=(), display-capture=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
  X-Permitted-Cross-Domain-Policies: none

/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

/manifest.webmanifest
  Cache-Control: no-cache

/app/*
  Cache-Control: no-cache

/fonts/*
  Cache-Control: public, max-age=2592000
